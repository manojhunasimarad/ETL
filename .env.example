# Copy to .env (git-ignored) to override the defaults. Never commit .env.
# From your laptop the database is on localhost; inside Docker Compose it is "postgres".
ECOM_DB_HOST=localhost
ECOM_DB_PORT=5432
ECOM_DB_USER=ecom
ECOM_DB_PASSWORD=ecom
ECOM_DB_NAME=ecom

# Ask your data (docs/ASK.md): a key from Google AI Studio
GEMINI_API_KEY=
# Optional: pin a model instead of the moving alias
# GEMINI_MODEL=gemini-flash-latest
# Optional: password of the read-only role the Ask feature queries with
# ECOM_READER_PASSWORD=ecom_reader

# Optional (Linux): keep files written by Airflow owned by you
# AIRFLOW_UID=1000
